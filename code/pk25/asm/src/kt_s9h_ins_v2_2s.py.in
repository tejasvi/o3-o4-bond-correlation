HREC = dict((N, dict((F, (OWN + '/m3/out/m3_s9h_%s_N%d_J300_v1.json' % (F, N), OWN + '/m3/out/m3_run_s9h_v1_1_asm.%d.out' % N)) for F in ('NIH', 'NHT', 'DH')))
