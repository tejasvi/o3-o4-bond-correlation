# TAU_D3B_v1: the certified upper end of Lemma B's tau (the type-B rows of D3 at d_L = -1) for N in {3, 4} and every J >= 300;
# the TAU_SOURCE of SPEC_HS_INV_NORMX_v1_2_ADD2_1. Format S4U_KV_v1 ("KEY = value"; lines starting with # are comments). Values
# named _HI are upper ends rounded up, _LO lower ends rounded down; N*_RW_HI is the export's own decimal.
RECORD = TAU_D3B_v1
FORMAT = S4U_KV_v1
EXPORT_STATUS = CERTIFIED
PRODUCER = pk08
CODE = pk08/px08_tau_d3b_v1_1.py:4b92f0dbbf217a4e4cb43f011368cc4634a2a70042a0eec12efaea48cd6c7279
LEMMA_NOTE_D3B = pk08/HS_TYPEB_LEMMA_NOTE_v1_1.md:801099463aa4dff112c1bc2078c943f8aff15ecdcf9738aed1a7d9f2f03f0e53
SPEC_ADD2_1 = pk15/SPEC_HS_INV_NORMX_v1_2_ADD2_1.md:89216d7961dc7df87110c96fd4776993b646270cc26e3e0e2ccc439046de2c7e
CLAIM = for N in {3, 4} and every J >= 300: tau(J) <= N*_TAU_HI and 1 + tau(J)^2 <= N*_ONE_PLUS_TAU2_HI, where tau^2 = lambda_0 v_0^2/<u,w>^2 - 1 is Lemma B's tau (LEMMA_NOTE_D3B sect. 0 and B6; OPERATOR_D3B of SPEC_ADD2_1)
CHAIN = 1 + tau^2 = (1 + R_w^2)/RQ (B6), RQ = ||w||^2/(lambda_0 v_0^2) = I_free RQ_h/(lambda~_0 I_1col), with I_free = ||w||^2/main_free, lambda~_0 = lambda_0/lambda_h, I_1col = v_0^2/main_1col and RQ_h = main_free/(lambda_h main_1col); since I_1col < 1 (I1COL_DEF), 1 + tau^2 <= (1 + R_w,hi^2)/RQ_lo with RQ_lo = I_free,lo RQ_h,lo/lambda~_0,hi
MAIN_TERMS = each main term is the Gaussian (matrix-tree) term of its graph G (V vertices, edge weights c_e, normalized measure on S^(N-1)): main(G) = |S^(N-1)|^-(V-1) (2 pi/J)^((N-1)(V-1)/2) det_red(L_G)^-((N-1)/2). The ratios I_free, lambda~_0, I_1col and RQ do not depend on the measure normalization, and in RQ_h the area and 2 pi/J powers cancel (V - 1: 5 = (8 - 5) + 2)
I_FREE_DEF = ||w||^2 = <V 1, K V 1> (w = K^(1/2) V 1) and I_free = <V 1, K V 1>/main_free (pk10 endw.py l.4; the free 2 x 3 grid of l.17-19 is strip_graph(2, 1, 0), C-DEF; its det_red is 15, C-FREE15); the endw records claim |I_free(J) - sum_k a_k t^k| <= err for every J >= 300, t = 1/J, t = 0 included
I_FREE_SOURCE = pk03/out/m3_endw_N4_J300_v1_7.json:436a143918fa2ebaa68ee3d16fab632c27bd29b822d4c7052c92dc257eaf88af ; pk03/out/m3_endw_N3_J300_v1_7.json:5e94d11eea2e6f55e7db781e02c197649ec6f10d8ab15a8f3508805642ed7885 ; pk03/out/m3_run_v1_7_asm.4.out:a5b294f364f9399b9d12f89af6ce1a1e598b8b424bc6e60d35e122ebd1391b97 ; pk03/out/m3_run_v1_7_asm.3.out:18964e97c320395f44b5923d132b1ac65c95b935cc8708a50e197076cc24e0dc ; pk10/scripts/endw.py:1c4efd9409470625309a8100bcb207165ee2732031c145f340068d79003af073
I_FREE_LO_RULE = N*_I_FREE_LO <= the arb lower end of sum_k (a_k - ak_rad_k) t^k - err over the ball t in [0, 1/300] (t^k by multiplication)
LAMBDA0_DEF = lambda_0 = the top eigenvalue of T = Z Z* >= 0 on H, so lambda_0^2 <= tr_H T^2 <= U_N lambda_h^2 (S4_U_CERTIFIED_v3 CLAIM, every J >= 300) and lambda~_0 <= U_N^(1/2) <= N*_LAMBDA0T_HI (N*_LAMBDA0T_HI^2 >= N*_U_USED exactly); lambda_h is the one of HS_INV_NORMX_v1's LAMBDA_H_DEF (the 3- and 2-column strips with the ends (A_EX, B_EX))
U_SOURCE = pk08/S4_U_CERTIFIED_v3.md:eb98948365fa35498206c9f1b80c6d98d421f69b9dca6c245f3f2d1198112751 ; pk08/out/HS_INV_NORMX_v1_d3d4.kv:45a2ab00dcbe47cf6873e5b12db69a1ff8ae3171c84abbc57c5ee43f8a39b343
I1COL_DEF = v_0 = int e^(J(s.e - 1)) dsigma(s) over S^(N-1) (LEMMA_NOTE_D3B l.76-77) = Gamma(N/2) (2/J)^nu e^-J I_nu(J) with nu = (N-2)/2 (DLMF 10.32.2), and int V = v_0^2 (B6); main_1col = v_0,main^2 with v_0,main = (2 pi/J)^((N-1)/2)/|S^(N-1)|, so I_1col = (sqrt(2 pi J) e^-J I_nu(J))^2. N = 3: sqrt(2 pi J) e^-J I_1/2(J) = 1 - e^-2J < 1 (DLMF 10.39.1: I_1/2(z) = (2/(pi z))^(1/2) sinh z). N = 4: I_nu(J) decreases in nu >= 0 at fixed J > 0 (DLMF 10.37), so sqrt(2 pi J) e^-J I_1(J) < 1 - e^-2J; directly, by DLMF 10.32.2 at nu = 1, sqrt(2 pi J) e^-J I_1(J) = (2 J^3/pi)^(1/2) int_0^2 e^-Js (s (2 - s))^(1/2) ds < (2 J^3/pi)^(1/2) int_0^inf e^-Js (2 s)^(1/2) ds = 1. So I_1col < 1 for every J > 0 at N = 3 and 4, and the bound uses 1; C-I1COL is a numerical control at J = 300, 1e3, 1e4, 1e6 (the N = 3 identity, the N = 4 value below 1, and I_1 < I_1/2)
RQH_DEF = RQ_h = (d3/(15 d2))^((N-1)/2) = PR/15^((N-1)/2), d3/d2 = detred(3)/detred(2) of strip_graph(ncols, A_EX, B_EX) (the COPY block of px08_m2bc4 l.448-484, C-COPY; PR checked against the TRB record's N*_PR, C-PREF); det_red of the 1-column path is 1; the half-integer power in arb, N*_RQH_LO <= its lower end
STRIP_SOURCE = pk08/px08_m2bc4.py:6527d21b7661a355c6534cc055f1fb8f3ae74be9256dbd6a3c65067ca6a34a17 ; pk08/S4_TRB_CERTIFIED_v1.md:2c17c287c0affbfe0e0fcbd8097edff2258ea1109d91381d6206a11d4efdd694
RW_DEF = R_w = ||Q0 w-hat||, w-hat = w/<u,w> (SPEC_S8_CERT_v1 l.106), so <u,w>^2 = ||w||^2/(1 + R_w^2) (B6); N*_RW_HI = the largest Rw_hi (field 17 of the export's FIELDS) over the 904 pieces per N, which tile [300, inf) with no gap (C-COVER; pk07's C-GRID-ALL PASS)
RW_SOURCE = pk07/out/export_kt_s9h_v1_2_vsweep.kv:10f3c3d9a18b9c7a596121a8dbec7d2b82afb366704845a7c00e066c8bf6d4f6 ; pk07/out/out_kt_s9h_v1_2_vsweep.out:58814f7f59dd0d8e9d16b73084b3cc5072f94fb1138300a112e0e49ff017835f ; pk11/SPEC_S8_CERT_v1.md:3d4276002e175d5db717cbfed07deab5b9f779b791972b9b95b0a17bc851ffc1
TAU_RULE = N*_RQ_LO <= N*_I_FREE_LO N*_RQH_LO/N*_LAMBDA0T_HI, N*_ONE_PLUS_TAU2_HI >= (1 + N*_RW_HI^2)/N*_RQ_LO and N*_TAU_HI^2 >= N*_ONE_PLUS_TAU2_HI - 1, each in exact rationals (C-ROUND)
