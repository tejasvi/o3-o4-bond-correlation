}

if not (os.path.isdir(OUT_DIR) and os.path.realpath(os.path.dirname(OUT_PATH)) == os.path.realpath(OUT_DIR)
        and os.path.realpath(OUT_DIR).startswith(os.path.realpath(OWN) + os.sep)):
