# QEF_DLM1_v1: single-bond crude bounds at d_L = -1 for the truncated-Cov readings R_e and R_f (pk02, kt_qef_dlm1_v1_1). Format
# S4U_KV_v1; computed decimals are exact strings in e-form, upper ends (the smallest 12-significant-digit decimals whose
# squares are at or above the formula's square); N*_A and N*_TAU_HI are copied strings.
RECORD = QEF_DLM1_v1
FORMAT = S4U_KV_v1
EXPORT_STATUS = CERTIFIED
REVIEW_STATUS = math PENDING (the one-bond forms of Lemma B, A-D4 and A-D4M); code: the review found no defect in v1 (7d362ea3), and v1_1 changes only the binding line and the write order
PRODUCER = pk02
CODE = pk02/kt_qef_dlm1_v1_1.py:7ee17059be221031a27d22336d8c02eb0e4b5c71552d4f5aa568ad4b8fdf3492
VERDICT_OF_WRITER = VALID
SUPERSEDES = pk02/out/QEF_DLM1_v1_r1.kv:773aa6f921343a7b857fe30de8a74c1526d99c09904624150646fb09113e7769 (the same twelve values, C-SAME; re-issued for the ruled binding line "RECORD <file name> sha256 <full sha256>" )
INPUT = pk02/out/TRICK_DLM1_v1_4_r1.kv:d6afc761daf44d69c49926a6dfdc08d836698fcfcc76e3d6892d5ff6581424d5
