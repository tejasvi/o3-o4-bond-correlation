{
 "author": "pk11",
 "conventions": {
  "assembly": "ratios to Z = 1,0; c_t = R(T,0), c_b = R(B,0); E_j[X_c] = R(X,j) - c_b R(T,j) - c_t R(B,j) + c_t c_b R(1,j); v_j = Cov(s_j(c'), X_c) = E_j[X_c] - R(1,j) E_0[X_c]; the row term <eps, X u> = sum_j alpha_j v_j with alpha S8's chain components (A2's exact one-sided term)",
  "factor_cp": "['cp', a, c]: S8's boundary state on column c: a = 0 the vacres p polynomial ('p', (3c, 3c+1, 3c+2), q1, q2, q3); a >= 1 ('xi', (3c, 3c+1, 3c+2), S[0][a], S[1..9][a]) of the z9sym trial-state file, in place of p",
  "factor_p": "['p', c]: the vacres K3 polynomial on column c (the bulk beyond the window)",
  "factor_xi": "['xi', [u, v]]: ('xi', (u, v, v), 0.0, e_1)",
  "graph": "kt_s8h_mk's window: lapl2.strip_graph columns with vacmod2's A_EX, B_EX ends (a vac column keeps its (3c, 3c+2) edge), vertex 3 c + r, row r = 0 the top, pairs as listed (F = V + #pairs)",
  "packing": "the kernel largest code D (D+1)^(F-1) against 2^63 - 1 (int64) and 2^64 - 1 (uint64)"
 },
