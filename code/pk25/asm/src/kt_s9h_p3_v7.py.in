    except Refused as e:
        out('  refused: %s' % e)
        RXYP, ok = {}, False
    out('C-E3-READ: pk22\'s certified E3 records e3_sq2_v2 (N4 %s, N3 %s; format %r, kind xy, the second-order claim, sources MR_SPECTRAL v4 and C10) '
        'on all %d pieces of R4\'s grid; R_xy/(t |chi|) <= min(R_hat, c2_hi^1/2) per piece -> %s' % (
            PINS[E3J[4]][:8], PINS[E3J[3]][:8], E3FORMAT, len(RXYP), gate(fails, 'C-E3-READ', ok)))
    if ok:
        for N in (4, 3):
