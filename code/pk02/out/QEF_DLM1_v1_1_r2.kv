INPUT = pk08/HS_TYPEB_LEMMA_NOTE_v1_1.md:801099463aa4dff112c1bc2078c943f8aff15ecdcf9738aed1a7d9f2f03f0e53
INPUT = rv02/RULING_TRUNCATED_COV_SCOPE_rv02.md:6e38bd40639064d28ff4a84e9eb25d47d2c8ce71599c0d6ce7734bb363b9eea3
