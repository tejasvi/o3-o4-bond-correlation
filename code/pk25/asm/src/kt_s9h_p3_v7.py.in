            above = [k for k in kN if Fraction(dict(SPEC[2])[k][0]) >= LD_FLOOR[N]] or kN
            out('INFO N=%d E3 R_xy/(t |chi|): largest above J %s is %s on %s; on the last piece %s' % (
                N, LD_FLOOR[N], dec_hi(max((RXYP[k] for k in above), key=lambda x: float(x))), max(above, key=lambda k: float(RXYP[k])), dec_hi(RXYP[kN[-1]])))
    if fails:
        out('VERDICT INVALID (%s)' % ' '.join(fails))
        return 2
    IN = dict(IXS=dict((f, i) for i, f in enumerate(SPEC[1])), IXI=dict((f, i) for i, f in enumerate(INS[1])),
              IXL=dict((f, i) for i, f in enumerate(LM[1])), IX2=P2IX, SPEC=dict(SPEC[2]), SPECL=SPEC[2],
              INS=dict((k, v) for k, v in INS[2] if k.endswith('_h')), LM=dict(LM[2]), P2=P2R, JT=JT, CW=CWR, E4=E4, E6=E6, RD=RD, LW=LW, LH=LH,
              MU=MU, X=X, RXYP=RXYP, PLANT_KEY=None, PL=PL)
    try:
        dres = lemd_rows(IN)
        ok = True
    except Refused as e:
        out('  refused: %s' % e)
        dres, ok = {}, False
    lastk = dict((N, [k for k, v in SPEC[2] if k.startswith('N%d_' % N) and v[1] == 'inf'][0]) for N in (4, 3))
    out('C-ALPHA, C-ARROW, C-T0-Z, C-T0-L, C-PI0, C-ORDER-P, C-ENV, C-A0, C-MONO-TAIL, C-MONO-FAR, C-ZERO-EX, C-KT, C-CH-HULL, C-MU: the Lemma D rows '
        'd = 1..%d and the envelope on every finite piece from J %s (N4) and %s (N3) up%s (N4 %d, N3 %d pieces), normal and with x1t and R_xy doubled '
        '-> %s' % (DMAX, LD_FLOOR[4], LD_FLOOR[3], ', the last piece included (law forms; Pevw/t a dry stand-in)' if PART == 'full' else '',
                   sum(1 for k in dres if k.startswith('N4_')), sum(1 for k in dres if k.startswith('N3_')), gate(fails, 'C-LEMD', ok)))
    if fails:
        out('VERDICT INVALID (%s)' % ' '.join(fails))
        return 2
    k4 = sorted([k for k in dres if k.startswith('N4_') and dres[k]['jhi'] != 'inf'], key=lambda k: Fraction(dres[k]['jlo']))
    XS = dict(X)
    XS[4] = exact_data(C10X, C13X, 4, plant='SIGMA')
    run_plant('PLANT-SIGMA', lambda: lemd_piece(4, k4[0], dict(IN, X=XS)))
    run_plant('PLANT-ALPHA', lambda: lemd_piece(4, k4[0], IN, plant='ALPHA'))
    # C-LP-CTL: the last piece's law forms against the record leaves on three finite pieces per N
    try:
        ctl = {}
        for N in (4, 3):
            kN = sorted([k for k in dres if k.startswith('N%d_' % N) and dres[k]['jhi'] != 'inf'], key=lambda k: Fraction(dres[k]['jlo']))
            for k in (kN[0], kN[len(kN) // 2], kN[-1]):
                ctl[k] = lemd_piece(N, k, IN, ctl=True)['info']['ctl']
        ok = True
    except Refused as e:
        out('  refused: %s' % e)
        ok = False
    out('C-LP-CTL: on three finite pieces per N the law forms of s_x, s_y, c_x(-1), c_y(-1), v_y, m_xx, m_xy, c_h, mu_x, mu_y and Lambda meet the record '
        'leaves -> %s' % gate(fails, 'C-LP-CTL', ok))
    if ok:
        for k in sorted(ctl):
            c = ctl[k]
            out('INFO C-LP-CTL %s: law/record widths %s; law slopes v_y [%s] m_xx [%s] c_h [%s] c_x [%s]' % (
                k, ' '.join('%s %.2e/%.2e' % (nm, float(c[nm][0].rad()), float(c[nm][1].rad())) for nm in ('s_x', 'c_x(-1)', 'v_y', 'm_xx', 'c_h')),
                c['v_y'][2].str(4), c['m_xx'][2].str(4), c['c_h'][2].str(4), c['c_x(-1)'][2].str(4)))
    try:
        ok = sq2_check(CWR, IN['RXYP'])
    except Refused as e:
        out('  refused: %s' % e)
        ok = False
    out('C-SQ2: pk23\'s x1t_hi finite on all %d pieces (CW_X11 %s, STATUS %s) and E3\'s R_xy/(t |chi|) finite on all %d pieces (e3_sq2_v2 N4 %s, '
        'N3 %s) -> %s' % (len(CWR), PINS[CW][:8], cwst, len(IN['RXYP']), PINS[E3J[4]][:8], PINS[E3J[3]][:8], gate(fails, 'C-SQ2', ok)))
    run_plant('PLANT-SQ2', lambda: load_e3(4, SPEC, tamper='SQ2'))
    # C-JS per N (check 1 with the last piece in PART full)
    jsk = {}
    for N in (4, 3):
        keysN = sorted([k for k, v in SPEC[2] if k.startswith('N%d_' % N) and v[1] != 'inf'], key=lambda k: Fraction(dict(SPEC[2])[k][0]))
        lk = lastk[N] if PART == 'full' else None
        try:
            Js, i = cjs(N, res, dres, keysN, lastkey=lk)
            jsk[N] = (Js, i, keysN)
            ok = True
        except Refused as e:
            out('  refused: %s' % e)
            ok = False
        if ok:
            above = [k for k in keysN[i + 1:]] + ([lk] if lk else [])
            wr = max(float((max(dres[k]['ehat']) / dres[k]['mig']).upper()) for k in above)
            wr2 = max(float((max(dres[k]['ehat2']) / dres[k]['mig']).upper()) for k in above)
            wk = max(above, key=lambda k: float((max(dres[k]['ehat2']) / dres[k]['mig']).upper()))
            out('C-JS N=%d: J_s = %s (target %d): check 1 on the %d pieces above%s (worst row ratio %.4f, doubled %.4f on %s), check 2 on the %d finite '
                'pieces below -> %s' % (N, Js, JS_TARGET[N], len(above), ', the last piece included' if lk else '', wr, wr2, wk, i + 1,
                                       gate(fails, 'C-JS N=%d' % N, ok)))
        else:
            gate(fails, 'C-JS N=%d' % N, False)
    if 4 in jsk:
        Js, i, keysN = jsk[4]
        pk, ptop = keysN[i + 1], (lastk[4] if PART == 'full' else keysN[-1])
        lk4 = lastk[4] if PART == 'full' else None
        run_plant('PLANT-SIGN', lambda: sign_d(lemd_rows(dict(IN, PLANT_KEY=pk), plant='SIGN', keys=[pk])))
        run_plant('PLANT-JS-W', lambda: cjs(4, res, dres, keysN, plant='JSW', lastkey=lk4))
        # PLANT-JS-D: the top piece's d = 1 row past mig(xc) with the doubled bars only (above every boundary J_s may reach)
        run_plant('PLANT-JS-D', lambda: cjs(4, res, dict(dres, **lemd_rows(dict(IN, PLANT_KEY=ptop), plant='JSD', keys=[ptop])), keysN, lastkey=lk4))
    if 4 in jsk and 3 in jsk:   # the writer: window rows below J_s, Lemma D rows above (the last piece in PART full)
        allr, pcs = {}, []
        for N in (4, 3):
            Js, i, keysN = jsk[N]
            for j, k in enumerate(keysN):
                allr[k] = res[k] if j <= i else dres[k]
                pcs.append(k)
            if PART == 'full':
                allr[lastk[N]] = dres[lastk[N]]
                pcs.append(lastk[N])
        frows = fact_rows(allr, pcs)
        xyr = ('window rows e_hi(d) jhi below J_s (D2_DESIGN_v1_3 (b)); Lemma D on P = span{u_x, u_y, z} above J_s (P3_NOTE_v1, the W_ext arrowhead); '
               'J_s N4 %s, N3 %s; Pevw/t on the last piece by Lemma P with A_h\'s law and the bridge; R_xy per piece from E3\'s certified e3_sq2_v2 '
               '(N4 %s, N3 %s); C_w from CW_X11 %s (STATUS %s)' % (jsk[4][0], jsk[3][0], PINS[E3J[4]][:8], PINS[E3J[3]][:8], PINS[CW][:8], cwst))
        src3 = src + '; P2 MR_LEMMAP_V3F %s, MR_LEMMAP v3 %s, C10 %s, C13 %s, E4 %s %s, E6 %s %s, E3 %s %s, MR_JOINT %s, CW_X11 %s, M4H %s, M2B %s, NU %s, S8 laws and pk25 h laws (pinned)' % (
            PINS[P2REC][:8], PINS[LEMMAP3][:8], PINS[C10REC][:8], PINS[C13REC][:8], PINS[E4J[4]][:8], PINS[E4J[3]][:8], PINS[E6J[4]][:8],
            PINS[E6J[3]][:8], PINS[E3J[4]][:8], PINS[E3J[3]][:8], PINS[JOINT][:8], PINS[CW][:8], PINS[M4H[0]][:8], PINS[M2B[0]][:8], PINS[NU_PATH][:8])
        ftext = rec_text_fact(TX, frows, SPEC[0]['TRIAL_SET'], src3, xyr)
        try:
            n = readback_fact(ftext, TX, frows, pcs)
            ok = True
        except Refused as e:
            out('  refused: %s' % e)
            n, ok = 0, False
        out('C-WRITE: the factored MR_CRUDEX text of the %d pieces (window below J_s, Lemma D above%s; %d rows) read back by the M1/M2 engine\'s rules '
            '-> %s' % (len(pcs), ', the last pieces included' if PART == 'full' else '', n, gate(fails, 'C-WRITE-LD', ok)))
        if ok and PART == 'full' and not fails:
            base = os.path.realpath(OWN if MODE == 'cert' else ASM)
            ddir = CERT_DIR if MODE == 'cert' else os.path.join(ASM, 'dry_%s' % TAG)
            os.mkdir(ddir)
            rp = os.path.join(ddir, 'MR_CRUDEX.kv')
            if os.path.realpath(os.path.dirname(rp)) != os.path.realpath(ddir) or not os.path.realpath(ddir).startswith(base + '/'):
                raise Refused('the record path check failed')
            with open(rp, 'x') as fh:
                fh.write(ftext)
            out('%s RECORD %s sha256 %s (%d rows, STATUS %s)' % ('CERTIFIED' if MODE == 'cert' else 'DRY', os.path.relpath(rp, CODEDIR), sha_file(rp), n,
                                                                 'CERTIFIED' if MODE == 'cert' else 'DRY'))
    for N in (4, 3):
        if N not in jsk:
            continue
        Js, i, keysN = jsk[N]
        above = keysN[i + 1:]
        for k in [above[0], above[len(above) // 2], above[-1]] + ([lastk[N]] if PART == 'full' else []):
            r = dres[k]
            I = r['info']
            out('INFO N=%d %s (J %s to %s): rows %s; env_r %s env_delta0 %s; mig %s; C_w %s, c/t %s; nu_z [%s] + t [%s]; g_z [%s] + t [%s]; k_z [%s] + t [%s]; '
                'eta_z/t [%s]; e_z/t %s, rho_xy/t %s; Lambda [%s]; m_xx/t [%s]; v_y [%s] + t [%s]; c_h + t [%s]; Pevw/t %s' % (
                    N, k, r['jlo'], r['jhi'], ' '.join(dec_hi(x) for x in r['ehat']), dec_hi(r['envr']), dec_hi(r['envd0']), dec_hi(r['mig']),
                    dec_hi(r['Cw']), dec_hi(r['ct']), I['nuz'].x0.str(8), I['nuz'].x1.str(4), I['gz'].x0.str(8), I['gz'].x1.str(4), I['kz'].x0.str(8),
                    I['kz'].x1.str(4), I['etaz'].x1.str(4), dec_hi(I['ez']), dec_hi(I['rxt']), I['Lam'].val().str(10), I['mxx_t'].str(4),
                    I['vy'].x0.str(8), I['vy'].x1.str(4), I['ch'].x1.str(4), dec_hi(I['pevw_t'])))
    unrun = [p for p in PLANT_NAMES if p not in EXEC] + [p for p in EXEC if p not in PLANT_NAMES or EXEC.count(p) != 1]
    out('PLANTS: %d of %d must-fire plants ran (not run or repeated: %s); not firing: %s' % (
        len(set(EXEC)), len(PLANT_NAMES), ' '.join(unrun) if unrun else 'none', ' '.join(nofire) if nofire else 'none'))
    if nofire or unrun:
        fails.append('PLANTS')
    out('RUN wall %.1f s' % (time.time() - t0))
    out('VERDICT %s' % (('VALID (PART %s; %s)' % (PART, ('certified record' if MODE == 'cert' else 'dry record') if PART == 'full' else 'finite pieces; no record')) if not fails
                        else 'INVALID (%s)' % ' '.join(fails)))
    return 0 if not fails else 2


PLANTS_WINDOW = ('PLANT-PIN', 'PLANT-ROWS', 'PLANT-ENV', 'PLANT-SIGNW', 'PLANT-ZERO', 'PLANT-10P', 'PLANT-WRITE', 'PLANT-EDEF')
PLANT_NAMES = PLANTS_WINDOW + ('PLANT-ZEROX', 'PLANT-PI0', 'PLANT-IHR', 'PLANT-A0E4', 'PLANT-MAIN-N', 'PLANT-MAIN-E4', 'PLANT-SIGMA', 'PLANT-ALPHA', 'PLANT-SQ2', 'PLANT-SIGN',
                               'PLANT-JS-W', 'PLANT-JS-D', 'PLANT-TIE-H') + tuple('PLANT-MONO-' + _t for _t in MONO_TERMS)


if __name__ == '__main__':
    from flint import arb, ctx
    import sympy as sp
    ctx.prec = 256
    try:
        rc = main()
    except Refused as e:
        out('STOP Refused: %s' % e)
        out('VERDICT INVALID (refused)')
        rc = 2
    FH.close()
    sys.exit(rc)
